# Strader settings. Copy to .env and fill in.
#
# SECRET VALUES DO NOT GO IN THIS FILE. They live in the vault file named by
# STRADER_SECRETS_FILE — /home/vault/<project>/env, mode 0600, outside every
# project tree (credential estate convention, Steve to COO, 2026-08-25). The
# loader (strader/config.py) refuses a secret found here, so a value pasted
# into .env fails at start-up with a message naming the field, not later as a
# broker or feed error.

STRADER_SECRETS_FILE=/home/vault/Strader/env

SCHWAB_CALLBACK_URL=https://127.0.0.1:8182  # OAuth callback URL configured in the Schwab app
SCHWAB_TOKEN_PATH=./tokens/schwab_token.json  # OAuth token file (retired at execd stage 3, st-p8k8)
ALERT_BACKEND=pushover  # strader/alerts.py: pushover | twilio

# The TRADING app (app 2, Accounts and Trading — st-p9mx). Only execd uses it.
# Both optional here: the callback falls back to SCHWAB_CALLBACK_URL when the
# same URL is registered on both apps, and the token path has a default.
#SCHWAB_TRADING_CALLBACK_URL=https://127.0.0.1:8182
#SCHWAB_TRADING_TOKEN_PATH=./tokens/schwab_trading_token.json

# The vault file holds KEY=VALUE lines, one per secret:
#   SCHWAB_API_KEY, SCHWAB_APP_SECRET   developer.schwab.com app 1, market data (required;
#                                       this app cannot trade — see app 2 below)
#   DATABENTO_API_KEY                   databento.com (required for Live ingest; metered)
#   GEXBOT_API_KEY                      GexBot (raw key; readers add the gexbot_custom_ prefix)
#   PUSHOVER_TOKEN, PUSHOVER_USER       pushover.net (when ALERT_BACKEND=pushover)
#   TWILIO_SID, TWILIO_AUTH,            twilio.com (when ALERT_BACKEND=twilio; all four
#   TWILIO_FROM, TWILIO_TO              are required or the loader fails naming each one)
#   SCHWAB_TRADING_API_KEY,             developer.schwab.com app 2, the Accounts and
#   SCHWAB_TRADING_APP_SECRET           Trading app — execd only (st-p9mx)
# To move an existing .env's values there:
#   python3 /root/projects/COO/factory/scripts/vault-migrate-env.py --help
