#!/bin/sh
# bead-event hook — appends to a local JSONL audit log. No Gas City dependency.
# Replaced the gc-installed hook 2026-06-12 [co-zk7p]; the GC version is in git
# history (gc-hook-stamp 2026-05-24) and can be reinstated via `gc hooks install`
# if Gas City returns to service.
# Args: $1=issue_id  $2=event_type  stdin=issue JSON
EVENT="bead.created"
BEADS_DIR="${BEADS_DIR:-.beads}"
LOG="${BEADS_DIR}/local-events.jsonl"
DATA=$(cat | tr -d '\n')
printf '{"ts":"%s","event":"%s","id":"%s","issue":%s}\n' \
  "$(date -u +%FT%TZ)" "$EVENT" "$1" "${DATA:-null}" >> "$LOG" 2>/dev/null || true
