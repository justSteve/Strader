[Unit]
# Early half of the Globex day — ES trades + MBP-1 from 00:00 CT until the
# session capture takes over at 02:50. [st-9olq]
#
# Sibling of strader-capture.service (02:50–15:05, Steve's ruling st-btu) and
# strader-capture-evening.service (15:06 → end of day). One process per
# calendar day directory: the evening run ends at 23:59:59 in yesterday's
# directory, this one opens today's at 00:00. Supervision copied from the
# session unit for the reasons written there.
Description=Strader Databento live capture — early session (00:00 → 02:50 CT)
Documentation=https://github.com/justSteve/Strader
After=network-online.target
Wants=network-online.target

StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=exec
WorkingDirectory=/root/projects/Strader
Environment=PYTHONPATH=/root/projects/Strader
ExecStart=/root/projects/Strader/.venv/bin/python \
    /root/projects/Strader/scripts/corpus_stream_databento.py \
    --streams es,es-mbp1 --now --until-ct 02:50

Restart=on-failure
RestartSec=2s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=strader-capture-early

KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
