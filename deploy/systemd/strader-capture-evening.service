[Unit]
# Evening half of the Globex day — ES trades + MBP-1, 15:06 CT to the end of the
# calendar day (Friday: 16:05, the CME close). [st-9olq]
#
# Sibling of strader-capture.service, which keeps Steve's 02:50–15:05 CT session
# window exactly as ruled (st-btu). This unit exists because the premarket
# volume profile had to banner an 11-hour hole every morning: the evening
# session was never captured, though the plan covers it and the disk holds it.
# The weekday-dependent stop time lives in scripts/cron/capture-evening.sh; the
# supervision (Restart=on-failure with the stretching backoff, SIGINT, journald)
# is copied from the session unit for the same reasons written there.
#
# [Install] WantedBy=multi-user.target means a reboot starts this unit whatever
# the clock says — on 2026-09-08 (03:06 boot) and 08-28 (03:30 boot) it ran
# beside strader-capture and doubled the tape. The guard is in the wrapper:
# capture-evening.sh exits 0 before the 15:06 / Sun 17:00 open, so the timer
# remains the only real start. [st-7kwg]
Description=Strader Databento live capture — evening session (15:06 CT → end of day)
Documentation=https://github.com/justSteve/Strader
After=network-online.target
Wants=network-online.target

StartLimitIntervalSec=600
StartLimitBurst=30

[Service]
Type=exec
WorkingDirectory=/root/projects/Strader
Environment=PYTHONPATH=/root/projects/Strader
ExecStart=/usr/bin/bash /root/projects/Strader/scripts/cron/capture-evening.sh

Restart=on-failure
RestartSec=30s
RestartSteps=5
RestartMaxDelaySec=5min

StandardOutput=journal
StandardError=journal
SyslogIdentifier=strader-capture-evening

KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
