[Unit]
# GexBot 1Hz orderflow leg. [st-pgfe] Container change only — see strader-capture.service for the
# full rationale. Window 08:30-15:05 CT, ported verbatim from the retired
# gexbot-orderflow-1s-supervisor.sh (pruned 2026-09-06, tag pre-prune-2026-09-05). The window now
# lives in ExecStart below and nowhere else; tests/scripts/test_gexbot_collect_window.py
# pins it against the collector's own measured default.
Description=Strader GexBot 1Hz orderflow leg
After=network-online.target
Wants=network-online.target

StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=exec
WorkingDirectory=/root/projects/Strader
Environment=PYTHONPATH=/root/projects/Strader
ExecStart=/root/projects/Strader/.venv/bin/python /root/projects/Strader/scripts/corpus_poll_gexbot_orderflow_1s.py --start-ct 08:30 --until-ct 15:05
Restart=on-failure
RestartSec=2s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=strader-gexbot-orderflow-1s
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
