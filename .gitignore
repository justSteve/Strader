# Dependencies
node_modules/

# Build output
dist/
*.egg-info/

# Environment
.env
.env.local
tokens/

# Data (runtime, not tracked)
data/
# EXCEPTION, tracked via `git add -f`: data/measurement/decision_aligned_truth.json.
# The live meter READS it at runtime, so an untracked copy means a rebuilt box
# runs a meter that degrades to "truth table absent" until someone remembers to
# regenerate it — and CI cannot check the meter/study bucket contract at all
# (20 red runs, st-yyuz). It is a 200K published measurement result, not raw
# corpus; the rule above exists to keep gigabytes of tape out, not this.

# Claude Code local settings (security)
.claude/settings.local.json

# Beads runtime exclusions
.beads/*.log
.beads/*.tmp
.beads/snapshots/

# Dolt database files (added by bd init)
.dolt/
*.db

# Gas Town / Gas City (added by gt/gc)
.runtime/
.logs/
.gc/
__pycache__/
tui/flytui

# Beads / Dolt files (added by bd init)
.beads-credential-key

# Enterprise standard entries
.beads/beads.db
.beads/beads.db-shm
.beads/beads.db-wal
.beads/daemon.lock
.beads/daemon.log
.beads/daemon.pid
.beads/bd.sock
.beads/.local_version
.beads/last-touched
.venv/
*.pyc

# Session state (checkpoint, snapshot — runtime only)
.claude/state/
session-briefing.md

# Beads / Dolt files (added by bd init)
.beads/proxieddb/

# Runbook generated caches (regenerable; commentary/ is intentionally tracked)
runbook/mancini/parsed/
runbook/mancini/charts/

# Tailscale cert/key written into the repo root by `tailscale cert` [st-1o47]
*.ts.net.crt
*.ts.net.key
