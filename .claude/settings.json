{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/root/projects/Strader/.claude/hooks/scripts/schwab-gate.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "/root/projects/Strader/.claude/hooks/scripts/session-start.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "permissions": {
    "allow": [
      "Edit(*)",
      "Write(*)",
      "MultiEdit(*)",
      "Bash(cd *)",
      "Bash(pwd *)",
      "Bash(which *)",
      "Bash(test *)",
      "Bash(sleep *)",
      "Bash(true *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(bd *)",
      "Bash(bun *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(chmod *)",
      "Bash(mkdir *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(sort *)",
      "Bash(diff *)",
      "Bash(xargs *)",
      "Bash(jq *)",
      "Bash(timeout *)",
      "Bash(tee *)",
      "Bash(pip *)",
      "Bash(python3 -m pytest *)",
      "Bash(.venv/bin/python3 broker_schwab/readers/quote.py *)",
      "Bash(.venv/bin/python3 broker_schwab/readers/chain.py *)",
      "mcp__fetch__fetch",
      "mcp__github__*",
      "mcp__tradingview__*",
      "Read(*)",
      "Glob(*)",
      "Grep(*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*credentials*)",
      "Read(**/*secret*)",
      "Read(//**/id_rsa)",
      "Read(//**/id_ed25519)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Bash(*schwab_gate_key*)",
      "Bash(*tokens/schwab*)",
      "Bash(*.env*schwab*)",
      "Bash(*schwab*.env*)"
    ]
  }
}
